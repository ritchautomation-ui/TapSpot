# Add these in Vercel > Project > Settings > Environment Variables, then redeploy.
# Or edit the fallback values in config/store.ts before pushing to GitHub.
NEXT_PUBLIC_SITE_URL=
# Email / Facebook / Messenger already have defaults in config/store.ts; set these only to override.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_SERVICE_AREA=

# --- Smile U Love booking demo (see docs/CLINIC_BOOKING_SETUP.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in a NEXT_PUBLIC_ variable or share it.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into the staff page, e.g. staff@example.com
STAFF_EMAILS=
# Make custom webhook URL, and the inbox that should be told about new requests
MAKE_WEBHOOK_URL=
CLINIC_NOTIFY_EMAIL=
